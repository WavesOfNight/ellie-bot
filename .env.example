# ---------------------------------------------------------------------------
# Ellie [BOT] — modèle de configuration
#
# Les mêmes valeurs doivent être copiées dans :
#   packages/database/.env   (DATABASE_URL)
#   apps/bot/.env            (DATABASE_URL, TOKEN_ENCRYPTION_KEY, DISCORD_DEV_GUILD_ID)
#   apps/twitch-bot/.env     (DATABASE_URL, TOKEN_ENCRYPTION_KEY)
#   apps/web/.env.local      (DATABASE_URL, TOKEN_ENCRYPTION_KEY, NEXTAUTH_URL, NEXTAUTH_SECRET)
#
# Sur le serveur, deploy/setup.sh génère ces fichiers automatiquement (chmod 600).
#
# Le token Discord, les identifiants Twitch et la clé API Anthropic ne se mettent JAMAIS ici :
# ils se saisissent dans le panel (Paramètres) et sont stockés chiffrés en base.
# ---------------------------------------------------------------------------

# Chemin ABSOLU et IDENTIQUE partout (un seul fichier SQLite partagé par les 3 applications)
DATABASE_URL="file:/opt/ellie-bot/data/ellie.db"

# 32 octets en hexadécimal, identiques dans les 3 applications.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Bot Discord (facultatif) : ID d'un serveur de test pour déployer les commandes slash instantanément.
# Vide = déploiement global (peut prendre jusqu'à une heure la première fois).
DISCORD_DEV_GUILD_ID=""

# Panel web
NEXTAUTH_URL="https://ellie.exemple.com"
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
